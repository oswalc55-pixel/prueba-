<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Alta">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Alta de producto"
        android:id="@+id/tvAltadeproducto"
        android:textSize="35dp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="20dp"/>

    <EditText
        android:id="@+id/etCodigoProducto"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Codigo del producto"
        android:textAlignment="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/tvAltadeproducto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="20dp"/>

    <EditText
        android:id="@+id/etNombreProducto"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Nombre del producto"
        android:textAlignment="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/etCodigoProducto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="20dp"/>

    <EditText
        android:id="@+id/etCantidad"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Cantidad"
        android:textAlignment="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/etNombreProducto"
        app:layout_constraintStart_toEndOf="@+id/etPrecio"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="20dp"/>

    <EditText
        android:id="@+id/etPrecio"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Precio"
        android:textAlignment="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/etNombreProducto"
        app:layout_constraintEnd_toStartOf="@+id/etCantidad"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="20dp"
        />

    <EditText
        android:id="@+id/etCategoria"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Categoria"
        android:textAlignment="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/etCantidad"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="20dp"/>

    <Button
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="GUARDAR PRODUCTO"
        android:id="@+id/btnGuardarProducto"
        app:layout_constraintTop_toBottomOf="@+id/etCategoria"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="20dp"/>

    <Button
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="CANCELAR"
        android:id="@+id/btnCancelar"
        app:layout_constraintTop_toBottomOf="@+id/btnGuardarProducto"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="20dp"/>



</androidx.constraintlayout.widget.ConstraintLayout>